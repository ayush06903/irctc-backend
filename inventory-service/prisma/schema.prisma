jjgenerator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
  CANCELLED
}

// is table me we store data about all the schedule that are stored in inventory
model ScheduleInventory {                 // each row represent a schedule
  id            String   @id @default(uuid())
  scheduleId    String   @unique
  trainId       String
  trainNumber   String
  trainName     String
  departureDate DateTime @db.Date
  totalSeats    Int
  available     Int
  locked        Int      @default(0)
  booked        Int      @default(0)
  status        String   @default("ACTIVE")
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seats SeatInventory[]

  @@index([trainId])
  @@index([scheduleId, status])
  @@index([departureDate])
  @@map("schedule_inventories")
}

model SeatInventory {       //in seatInventory hmm train me present har seat ke lie entry create krenge
                            //ye jo seatInventory table hai ye source of truuth hai--->ye hme actual status batayegi seat ka(booked/available/locked)
                            //is seat inventory table me hmm ROW LEVEL USE KRENGE USE KRENGE FOR BOOKING

          //For aggregate summery we need to read a single row of scheduleInventory and to checck availablity of seats of perticular schedule we need to read each row of seatInventory(slow operation)
  id                  String     @id @default(uuid())
  scheduleInventoryId String
  scheduleId          String
  seatId              String
  seatNumber          Int
  seatType            String
  price               Float
  status              SeatStatus @default(AVAILABLE)
  lockedBy            String?
  lockedAt            DateTime?
  lockExpiresAt       DateTime?
  bookingId           String?
  version             Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  scheduleInventory ScheduleInventory @relation(fields: [scheduleInventoryId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, seatId])
  @@unique([scheduleId, seatNumber])
  @@index([scheduleId, status])
  @@index([lockExpiresAt, status])
  @@index([bookingId])
  @@map("seat_inventories")
}

// --- SEGMENT BOOKING: Route topology per schedule ---
// Stores the ordered list of stations for each schedule, populated from SCHEDULE_CREATED event.
//since segment booking ko enable krne ke lie we need sequence number of all the stations to jo ye hamari routestop table hai ye stationId ko sequence number me convert krti hai aur phr hme ordered list of stations provide krti hai
// Used to resolve station IDs to sequence numbers for segment overlap checks.
model RouteStop {
  id             String @id @default(uuid())
  scheduleId     String
  stationId      String
  stationName    String
  stationCode    String
  sequenceNumber Int

  @@unique([scheduleId, stationId])
  @@unique([scheduleId, sequenceNumber])
  @@index([scheduleId])
  @@map("route_stops")
}

// --- SEGMENT BOOKING: Per-segment seat lock/booking tracking ---
// Each row represents a seat locked or booked for a specific segment [fromSeq, toSeq).
// Two segments overlap if: a.fromSeq < b.toSeq AND b.fromSeq < a.toSeq
model SeatSegmentLock {             //ye table hmari segment booking ko enable krti hai--?13 hour 5 min
                    //lets say hmne kisi segment ke lie booking kri to seaInventory table me hmmne row level lock apply kara(us seat ka status locked hai ab) tabb hmm seatSegmentLock me entry krte hai which includes info of ki kis segment ke lie booking ho rhi hai
  id            String     @id @default(uuid())
  scheduleId    String
  seatId        String
  fromSeq       Int        // sequenceNumber of boarding station
  toSeq         Int        // sequenceNumber of alighting station
  status        SeatStatus @default(LOCKED)
  lockedBy      String?
  lockedAt      DateTime?
  lockExpiresAt DateTime?
  bookingId     String?
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([scheduleId, seatId])
  @@index([scheduleId, seatId, status])
  @@index([lockExpiresAt, status])
  @@index([bookingId])
  @@map("seat_segment_locks")
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  eventKey    String   @unique
  // Stored result of the original call, replayed verbatim when booking-service
  // retries a mutating request whose response it never received.
  response    Json?
  processedAt DateTime @default(now())

  @@index([eventKey])
  @@map("idempotency_records")
}
